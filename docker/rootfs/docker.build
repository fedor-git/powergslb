#!/bin/bash

set -euo pipefail

# Set timezone; TZ is passed as a Docker build-arg (default: UTC).
ln -sfv "/usr/share/zoneinfo/$TZ" /etc/localtime

# Install runtime packages.
dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm
dnf update -y
dnf install --setopt install_weak_deps=false --nodocs -y \
    bash-completion bind-utils iproute less MariaDB-server net-tools openssl pdns pdns-backend-remote

# Replace the default PowerDNS configuration file installed by the package.
mv /etc/pdns/pdns.conf.powergslb /etc/pdns/pdns.conf

# Add custom CA certificates into the system trust store used by the `http`/`tls` health checks.
update-ca-trust

# Bundle the DB-IP database (CC BY 4.0) for geo routing. The URL is month-stamped.
mkdir -p /usr/share/powergslb
dbip_url="https://download.db-ip.com/free/dbip-country-lite-$(date -u +%Y-%m).mmdb.gz"
curl -fsSL "$dbip_url" | gunzip > /usr/share/powergslb/dbip-country-lite.mmdb

# Enable services so systemd starts them on container boot.
systemctl enable mariadb pdns powergslb powergslb-certgen powergslb-dbinit

# No display manager, so multi-user.target is the boot goal.
systemctl set-default multi-user.target

# Mask systemd units unused in the container: no tty or interactive login, no D-Bus client, no swap or
# remote mounts, no kernel pseudo-filesystems (the host owns those), and a runtime-only journal.
systemctl mask \
    dbus.socket \
    dnf-makecache.timer \
    remote-fs.target \
    swap.target \
    sys-kernel-config.mount \
    sys-kernel-debug.mount \
    sys-kernel-tracing.mount \
    systemd-ask-password-console.path \
    systemd-ask-password-wall.path \
    systemd-creds.socket \
    systemd-hostnamed.socket \
    systemd-initctl.socket \
    systemd-journal-flush.service \
    systemd-network-generator.service \
    systemd-sysext.socket \
    systemd-tmpfiles-clean.timer \
    systemd-update-utmp-runlevel.service \
    systemd-update-utmp.service \
    systemd-user-sessions.service

# Stamp /etc and /var as current, so the ConditionNeedsUpdate= units skip the first boot.
touch /etc/.updated /var/.updated

# Remove package cache, MariaDB datadir, logs, and this script.
dnf clean all
rm -rf /var/cache/dnf /var/lib/mysql/* /var/log/* /tmp/* "$0"
